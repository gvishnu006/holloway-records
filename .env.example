# ─── Stripe ──────────────────────────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys
# Leave these blank to run the shop in DEMO MODE — the cart still works, the
# checkout button hands you a mock order number instead of a Stripe session.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret. For local testing:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# then copy the printed whsec_... value here.
STRIPE_WEBHOOK_SECRET=

# ─── Storefront ──────────────────────────────────────────────────────────────
# Absolute URL of the deployed site. Used for metadata, the sitemap, and the
# Stripe success/cancel redirects. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is
# detected automatically; set one of these for local dev if you want it pinned.
# NEXT_PUBLIC_SITE_URL=https://holloway-records.vercel.app
# STOREFRONT_URL=https://holloway-records.vercel.app
